<?xml version="1.0" encoding="utf-8"?>
<!-- Requirement SEC-011: the app's own (Java) networking only uses TLS with system CAs. The engine does its
     own networking with its own trust store (SEC-009). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
