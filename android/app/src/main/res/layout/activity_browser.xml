<?xml version="1.0" encoding="utf-8"?>
<!-- Toolbar order follows Ladybird's Qt browser window (UI-001). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:colorBackground"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/toolbar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp">

        <ImageButton
            android:id="@+id/back"
            style="@style/ToolbarButton"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back" />

        <ImageButton
            android:id="@+id/forward"
            style="@style/ToolbarButton"
            android:contentDescription="@string/forward"
            android:src="@drawable/ic_forward" />

        <ImageButton
            android:id="@+id/reload"
            style="@style/ToolbarButton"
            android:contentDescription="@string/reload"
            android:src="@drawable/ic_reload" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginHorizontal="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_location"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp">

            <ImageView
                android:id="@+id/security"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_info"
                app:tint="?android:textColorSecondary" />

            <EditText
                android:id="@+id/location"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/location_hint"
                android:importantForAutofill="no"
                android:imeOptions="actionGo"
                android:inputType="textUri"
                android:paddingHorizontal="8dp"
                android:selectAllOnFocus="true"
                android:singleLine="true"
                android:textSize="15sp" />

            <ImageButton
                android:id="@+id/shields"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/shields"
                android:src="@drawable/ic_shield"
                app:tint="@color/shields" />
        </LinearLayout>

        <TextView
            android:id="@+id/tab_count"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginHorizontal="6dp"
            android:background="@drawable/bg_tab_count"
            android:contentDescription="@string/tabs"
            android:gravity="center"
            android:text="1"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/menu"
            style="@style/ToolbarButton"
            android:contentDescription="@string/menu"
            android:src="@drawable/ic_menu" />
    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <TextView
            android:id="@+id/engine_status"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="32dp"
            android:text="@string/engine_starting"
            android:textAlignment="center" />

        <TextView
            android:id="@+id/link_preview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:background="@color/toolbar"
            android:ellipsize="middle"
            android:maxWidth="320dp"
            android:padding="4dp"
            android:singleLine="true"
            android:textSize="12sp"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/find_bar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/toolbar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:visibility="gone">

        <EditText
            android:id="@+id/find_query"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:hint="@string/find_in_page"
            android:importantForAutofill="no"
            android:imeOptions="actionSearch|flagNoPersonalizedLearning"
            android:inputType="text"
            android:singleLine="true" />

        <TextView
            android:id="@+id/find_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="8dp" />

        <ImageButton
            android:id="@+id/find_previous"
            style="@style/ToolbarButton"
            android:contentDescription="@string/find_previous"
            android:src="@drawable/ic_up" />

        <ImageButton
            android:id="@+id/find_next"
            style="@style/ToolbarButton"
            android:contentDescription="@string/find_next"
            android:src="@drawable/ic_down" />

        <ImageButton
            android:id="@+id/find_close"
            style="@style/ToolbarButton"
            android:contentDescription="@string/close"
            android:src="@drawable/ic_stop" />
    </LinearLayout>
</LinearLayout>
