LibWasm: Define cranelift_trap_message() without compiled fault recovery

BytecodeInterpreter::interpret() calls cranelift_trap_message() unconditionally,
but it was only defined when
WASM_COMPILED_FAULT_RECOVERY_SUPPORTED, which is 0 on Android, so the build
failed with "use of undeclared identifier".

Requirement: SEC-003

diff --git a/Libraries/LibWasm/AbstractMachine/BytecodeInterpreter.cpp b/Libraries/LibWasm/AbstractMachine/BytecodeInterpreter.cpp
index 7e31fac0..badd3113 100644
--- a/Libraries/LibWasm/AbstractMachine/BytecodeInterpreter.cpp
+++ b/Libraries/LibWasm/AbstractMachine/BytecodeInterpreter.cpp
@@ -64,8 +64,6 @@ struct CompiledFaultRecoveryContext {
 
 thread_local CompiledFaultRecoveryContext* s_compiled_fault_recovery = nullptr;
 
-#if WASM_COMPILED_FAULT_RECOVERY_SUPPORTED
-
 static StringView cranelift_trap_message(u8 trap_code)
 {
     // Cranelift reserves trap codes at the high end of u8:
@@ -85,6 +83,8 @@ static StringView cranelift_trap_message(u8 trap_code)
     }
 }
 
+#if WASM_COMPILED_FAULT_RECOVERY_SUPPORTED
+
 static bool is_wasm_memory_fault(Wasm::Configuration& configuration, void* address)
 {
     auto const& memories = configuration.frame().module().memories();
