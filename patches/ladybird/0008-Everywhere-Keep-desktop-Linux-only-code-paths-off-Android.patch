     AudioDecoderRegistration { FFmpeg::system_ffmpeg_audio_decoder_capabilities, FFmpeg::create_system_ffmpeg_audio_decoder },
 #endif
 };
@@ -71,7 +71,7 @@ static constexpr Array video_decoders_in_priority_order {
