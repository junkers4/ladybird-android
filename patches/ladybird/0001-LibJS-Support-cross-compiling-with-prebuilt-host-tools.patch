+# When cross-compiling, the build-time tools below cannot run on the build machine if they are built for the target.
+# Such builds must provide host builds of them in LADYBIRD_HOST_TOOLS_DIR instead.
+if (CMAKE_CROSSCOMPILING)
+    if (NOT LADYBIRD_HOST_TOOLS_DIR)
+        message(FATAL_ERROR "Cross-compiling LibJS requires LADYBIRD_HOST_TOOLS_DIR to contain host builds of generate-libjs-bytecode, flapc and generate_interpreter_layout")
+    endif()
+    set(BYTECODE_GENERATOR_BIN "${LADYBIRD_HOST_TOOLS_DIR}/generate-libjs-bytecode${CMAKE_HOST_EXECUTABLE_SUFFIX}")
+else()
+    build_rust_binary(
+        MANIFEST_PATH Flap/Cargo.toml
+        CRATE_NAME flapc
+        BINARY_NAME generate-libjs-bytecode
+        OUTPUT_PATH_VAR BYTECODE_GENERATOR_BIN
+    )
+endif()
 
