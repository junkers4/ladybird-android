<?xml version="1.0" encoding="utf-8"?>
<!-- Chrome-style settings: plain rows with title + current-value summary,
     section headers in accent color, switches inline on the right. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ladybird_surface"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/settingsToolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/ladybird_surface"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@color/ladybird_on_surface"
        app:title="@string/settings_title"
        app:titleTextColor="@color/ladybird_on_surface" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <TextView style="@style/Chromium.SettingsHeader" android:text="@string/settings_section_general" />

            <LinearLayout android:id="@+id/rowSearchEngine" style="@style/Chromium.SettingsRow">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView style="@style/Chromium.SettingsTitle" android:text="@string/settings_search_engine" />
                    <TextView android:id="@+id/searchEngineSummary" style="@style/Chromium.SettingsSummary" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:id="@+id/rowHomePage" style="@style/Chromium.SettingsRow">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView style="@style/Chromium.SettingsTitle" android:text="@string/settings_home_page" />
                    <TextView android:id="@+id/homePageSummary" style="@style/Chromium.SettingsSummary" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:id="@+id/rowColorScheme" style="@style/Chromium.SettingsRow">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView style="@style/Chromium.SettingsTitle" android:text="@string/settings_color_scheme" />
                    <TextView android:id="@+id/colorSchemeSummary" style="@style/Chromium.SettingsSummary" />
                </LinearLayout>
            </LinearLayout>

            <TextView style="@style/Chromium.SettingsHeader" android:text="@string/settings_section_site" />

            <LinearLayout android:id="@+id/rowJavascript" style="@style/Chromium.SettingsRow">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView style="@style/Chromium.SettingsTitle" android:text="@string/settings_javascript" />
                    <TextView style="@style/Chromium.SettingsSummary" android:text="@string/settings_javascript_summary" />
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/jsSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp" />
            </LinearLayout>

            <LinearLayout android:id="@+id/rowPinch" style="@style/Chromium.SettingsRow">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView style="@style/Chromium.SettingsTitle" android:text="@string/settings_pinch_zoom" />
                    <TextView style="@style/Chromium.SettingsSummary" android:text="@string/settings_pinch_zoom_summary" />
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/pinchSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp" />
            </LinearLayout>

            <TextView style="@style/Chromium.SettingsHeader" android:text="@string/settings_section_engine" />

            <LinearLayout android:id="@+id/rowUserAgent" style="@style/Chromium.SettingsRow">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView style="@style/Chromium.SettingsTitle" android:text="@string/settings_user_agent" />
                    <TextView android:id="@+id/userAgentSummary" style="@style/Chromium.SettingsSummary" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:id="@+id/rowNavCompat" style="@style/Chromium.SettingsRow">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView style="@style/Chromium.SettingsTitle" android:text="@string/settings_navigator_compat" />
                    <TextView android:id="@+id/navCompatSummary" style="@style/Chromium.SettingsSummary" />
                </LinearLayout>
            </LinearLayout>

            <TextView style="@style/Chromium.SettingsHeader" android:text="@string/settings_section_about" />

            <LinearLayout android:id="@+id/rowClearData" style="@style/Chromium.SettingsRow">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView style="@style/Chromium.SettingsTitle" android:text="@string/settings_clear_data" />
                    <TextView style="@style/Chromium.SettingsSummary" android:text="@string/settings_clear_data_summary" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:id="@+id/rowReset" style="@style/Chromium.SettingsRow">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView style="@style/Chromium.SettingsTitle" android:text="@string/settings_reset" />
                    <TextView style="@style/Chromium.SettingsSummary" android:text="@string/settings_reset_summary" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:id="@+id/rowAbout" style="@style/Chromium.SettingsRow">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView style="@style/Chromium.SettingsTitle" android:text="@string/menu_about" />
                    <TextView android:id="@+id/aboutVersion" style="@style/Chromium.SettingsSummary" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
