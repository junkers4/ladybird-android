<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".LadybirdActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ladybird_background"
        android:orientation="vertical">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/app_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/ladybird_surface"
            android:elevation="0dp">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@android:color/transparent"
                android:contentInsetStart="0dp"
                android:contentInsetEnd="0dp"
                app:contentInsetEnd="0dp"
                app:contentInsetStart="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp">

                    <ImageButton
                        android:id="@+id/homeButton"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/browser_home"
                        android:padding="8dp"
                        android:src="@drawable/ic_home"
                        android:tint="@color/ladybird_on_surface" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/urlBarCard"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="@color/ladybird_field_surface"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/ladybird_field_surface"
                        app:strokeWidth="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp">

                            <ImageView
                                android:id="@+id/securityIcon"
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_lock"
                                android:tint="@color/ladybird_on_surface_muted" />

                            <EditText
                                android:id="@+id/urlEditText"
                                style="@style/Widget.AppCompat.EditText"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:autofillHints="url"
                                android:background="@android:color/transparent"
                                android:gravity="center_vertical"
                                android:hint="@string/browser_search_url_hint"
                                android:imeOptions="actionGo|actionSearch"
                                android:inputType="textUri"
                                android:paddingStart="8dp"
                                android:paddingEnd="4dp"
                                android:selectAllOnFocus="true"
                                android:singleLine="true"
                                android:textColor="@color/ladybird_on_surface"
                                android:textColorHint="@color/ladybird_on_surface_muted"
                                android:textSize="16sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <ImageButton
                        android:id="@+id/newTabButton"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/menu_new_tab"
                        android:padding="8dp"
                        android:src="@drawable/ic_add"
                        android:tint="@color/ladybird_on_surface" />

                    <FrameLayout
                        android:id="@+id/tabCountButton"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:contentDescription="@string/browser_tabs"
                        android:focusable="true">

                        <FrameLayout
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:background="@drawable/bg_tab_counter">

                            <TextView
                                android:id="@+id/tabCountLabel"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:includeFontPadding="false"
                                android:text="1"
                                android:textColor="@color/ladybird_on_surface"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </FrameLayout>
                    </FrameLayout>

                    <ImageButton
                        android:id="@+id/networkModeButton"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/net_mode_switch"
                        android:padding="8dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_globe"
                        android:tint="@color/ladybird_on_surface" />

                    <ImageButton
                        android:id="@+id/menuButton"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/browser_menu"
                        android:padding="8dp"
                        android:src="@drawable/ic_more_vert"
                        android:tint="@color/ladybird_on_surface" />
                </LinearLayout>
            </com.google.android.material.appbar.MaterialToolbar>

            <ProgressBar
                android:id="@+id/loadingProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/ladybird_progress"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- Determinate Tor/I2P bootstrap bar: fills 0→100% while the daemon
                 builds its circuit; tinted to the active compartment. -->
            <ProgressBar
                android:id="@+id/netBootstrapProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:indeterminate="false"
                android:max="100"
                android:progress="0"
                android:progressTint="@color/net_tor"
                android:visibility="gone"
                tools:visibility="visible" />
        </com.google.android.material.appbar.AppBarLayout>

        <FrameLayout
            android:id="@+id/web_view_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/ladybird_surface">

            <org.serenityos.ladybird.WebView
                android:id="@+id/web_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                tools:context=".LadybirdActivity" />

            <FrameLayout
                android:id="@+id/newTabOverlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/ladybird_background"
                android:clickable="true"
                android:focusable="false"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <!-- Clean New Tab page: just our logo, no wordmark and no
                         centre search pill. Searching is done from the top
                         omnibox. The logo is tinted to the active compartment
                         (see applyNetworkTheme) and, while Tor/I2P bootstraps,
                         the colour "fills up" from the bottom (ntpLogoFill is a
                         vertical clip driven by bootstrap progress). -->
                    <FrameLayout
                        android:layout_width="140dp"
                        android:layout_height="140dp">

                        <ImageView
                            android:id="@+id/ntpLogo"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@string/app_name"
                            android:src="@drawable/ntp_logo_white" />

                        <ImageView
                            android:id="@+id/ntpLogoFill"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@null"
                            android:src="@drawable/ntp_logo_fill"
                            android:visibility="gone" />
                    </FrameLayout>

                    <!-- Bootstrap percentage shown under the logo while a
                         compartment connects (Tor / I2P). Only the logo + this
                         number change during loading. -->
                    <TextView
                        android:id="@+id/ntpLogoPercent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:textColor="@color/ladybird_on_surface_muted"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        tools:text="42%" />
                </LinearLayout>
            </FrameLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/findInPageBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:layout_margin="12dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/ladybird_surface"
                app:cardCornerRadius="24dp"
                app:cardElevation="6dp"
                app:strokeColor="@color/ladybird_outline_soft"
                app:strokeWidth="1dp"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="4dp">

                    <EditText
                        android:id="@+id/findInPageEdit"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:hint="@string/find_in_page_hint"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:singleLine="true"
                        android:textColor="@color/ladybird_on_surface"
                        android:textColorHint="@color/ladybird_on_surface_muted" />

                    <TextView
                        android:id="@+id/findInPageCounter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:textColor="@color/ladybird_on_surface_muted"
                        android:textSize="13sp"
                        tools:text="2 / 8" />

                    <ImageButton
                        android:id="@+id/findInPagePrev"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/find_in_page_prev"
                        android:padding="8dp"
                        android:src="@drawable/ic_arrow_up"
                        android:tint="@color/ladybird_on_surface" />

                    <ImageButton
                        android:id="@+id/findInPageNext"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/find_in_page_next"
                        android:padding="8dp"
                        android:src="@drawable/ic_arrow_down"
                        android:tint="@color/ladybird_on_surface" />

                    <ImageButton
                        android:id="@+id/findInPageClose"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/find_in_page_close"
                        android:padding="8dp"
                        android:src="@drawable/ic_close"
                        android:tint="@color/ladybird_on_surface" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </FrameLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/startupOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ladybird_surface"
        android:clickable="true"
        android:focusable="true">

        <ProgressBar
            android:id="@+id/startupPulse"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:indeterminateTint="@color/ladybird_accent" />

        <ImageView
            android:id="@+id/startupLogo"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:visibility="invisible" />
    </FrameLayout>

</FrameLayout>
