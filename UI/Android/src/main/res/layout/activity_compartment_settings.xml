<?xml version="1.0" encoding="utf-8"?>
<!-- Per-compartment settings (Tor / I2P / Normal). The toolbar is tinted to the
     compartment colour; the content rows are added from code. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ladybird_surface"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/compartmentToolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/ladybird_surface"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@color/ladybird_on_surface"
        app:titleTextColor="@color/ladybird_on_surface" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/compartmentContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp" />
    </ScrollView>
</LinearLayout>
