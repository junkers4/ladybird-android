<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginTop="10dp"
    android:background="@drawable/bg_ntp_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="6dp"
    android:paddingVertical="12dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/limitHost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/ladybird_on_surface"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="youtube.com" />

        <ProgressBar
            android:id="@+id/limitProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progress="40"
            android:progressTint="@color/ladybird_accent" />

        <TextView
            android:id="@+id/limitUsage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/ladybird_on_surface_muted"
            android:textSize="12sp"
            tools:text="24 of 60 min used today" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/limitRemove"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="6dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/dialog_remove"
        android:padding="9dp"
        android:src="@drawable/ic_delete"
        android:tint="@color/ladybird_on_surface_muted" />
</LinearLayout>
