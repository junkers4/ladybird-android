<?xml version="1.0" encoding="utf-8"?>
<!-- Overflow menu mirroring Vanadium/Chromium: circular icon chips on top,
     then icon+text rows separated into Vanadium's groups. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/ladybird_chip"
    app:cardCornerRadius="28dp"
    app:cardElevation="8dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fadeScrollbars="true"
        android:scrollbarStyle="insideOverlay">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="14dp"
            android:paddingBottom="10dp">

            <!-- Top icon row: forward / bookmark / share / page info / reload -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <ImageButton
                    android:id="@+id/menuForward"
                    style="@style/Chromium.MenuChip"
                    android:contentDescription="@string/browser_forward"
                    android:src="@drawable/ic_arrow_forward" />

                <ImageButton
                    android:id="@+id/menuBookmarkAdd"
                    style="@style/Chromium.MenuChip"
                    android:contentDescription="@string/menu_add_bookmark"
                    android:src="@drawable/ic_bookmark_add" />

                <ImageButton
                    android:id="@+id/menuShare"
                    style="@style/Chromium.MenuChip"
                    android:contentDescription="@string/menu_share"
                    android:src="@drawable/ic_share" />

                <ImageButton
                    android:id="@+id/menuPageInfo"
                    style="@style/Chromium.MenuChip"
                    android:contentDescription="@string/menu_page_info"
                    android:src="@drawable/ic_info" />

                <ImageButton
                    android:id="@+id/menuRefresh"
                    style="@style/Chromium.MenuChip"
                    android:contentDescription="@string/browser_reload"
                    android:src="@drawable/ic_refresh" />
            </LinearLayout>

            <LinearLayout android:id="@+id/rowNewPage" style="@style/Chromium.OverflowItem"
                android:layout_marginTop="10dp">
                <ImageView style="@style/Chromium.OverflowIcon" android:src="@drawable/ic_add" />
                <TextView style="@style/Chromium.OverflowText" android:text="@string/menu_new_tab" />
            </LinearLayout>

            <View style="@style/Chromium.OverflowDivider" />

            <LinearLayout android:id="@+id/rowHistory" style="@style/Chromium.OverflowItem">
                <ImageView style="@style/Chromium.OverflowIcon" android:src="@drawable/ic_history" />
                <TextView style="@style/Chromium.OverflowText" android:text="@string/menu_history" />
            </LinearLayout>

            <LinearLayout android:id="@+id/rowDeleteData" style="@style/Chromium.OverflowItem">
                <ImageView style="@style/Chromium.OverflowIcon" android:src="@drawable/ic_delete" />
                <TextView style="@style/Chromium.OverflowText" android:text="@string/menu_delete_browsing_data" />
            </LinearLayout>

            <View style="@style/Chromium.OverflowDivider" />

            <LinearLayout android:id="@+id/rowBookmarks" style="@style/Chromium.OverflowItem">
                <ImageView style="@style/Chromium.OverflowIcon" android:src="@drawable/ic_bookmark" />
                <TextView style="@style/Chromium.OverflowText" android:text="@string/menu_bookmarks" />
            </LinearLayout>

            <LinearLayout android:id="@+id/rowFindInPage" style="@style/Chromium.OverflowItem">
                <ImageView style="@style/Chromium.OverflowIcon" android:src="@drawable/ic_find" />
                <TextView style="@style/Chromium.OverflowText" android:text="@string/menu_find_in_page" />
            </LinearLayout>

            <LinearLayout android:id="@+id/rowDesktopSite" style="@style/Chromium.OverflowItem">
                <ImageView style="@style/Chromium.OverflowIcon" android:src="@drawable/ic_globe" />
                <TextView style="@style/Chromium.OverflowText"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/menu_desktop_site" />
                <ImageView
                    android:id="@+id/desktopSiteCheck"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_check"
                    android:visibility="gone" />
            </LinearLayout>

            <View style="@style/Chromium.OverflowDivider" />

            <LinearLayout android:id="@+id/rowSettings" style="@style/Chromium.OverflowItem">
                <ImageView style="@style/Chromium.OverflowIcon" android:src="@drawable/ic_settings" />
                <TextView style="@style/Chromium.OverflowText" android:text="@string/menu_settings" />
            </LinearLayout>

            <LinearLayout android:id="@+id/rowAbout" style="@style/Chromium.OverflowItem">
                <ImageView style="@style/Chromium.OverflowIcon" android:src="@drawable/ic_info" />
                <TextView style="@style/Chromium.OverflowText" android:text="@string/menu_about" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</com.google.android.material.card.MaterialCardView>
