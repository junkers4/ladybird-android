<?xml version="1.0" encoding="utf-8"?>
<!-- "Today's usage" overview: total time + a horizontal bar per site. Rows are
     added from code (see UsageOverviewActivity). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ladybird_surface"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/usageToolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/ladybird_surface"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@color/ladybird_on_surface"
        app:title="@string/usage_title"
        app:titleTextColor="@color/ladybird_on_surface" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/usageContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp" />
    </ScrollView>
</LinearLayout>
