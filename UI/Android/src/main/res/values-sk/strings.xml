    <string name="compartment_about_tor">O sieti Tor</string>
    <string name="compartment_tor_desc">Tor posiela vašu prevádzku cez tri dobrovoľnícke uzly, takže stránky vidia výstupný uzol Tor namiesto vašej skutočnej adresy. Je pomalší ako priame pripojenie a niektoré stránky výstupné uzly Tor blokujú.</string>
    <string name="compartment_verification">Overenie</string>
    <string name="compartment_tor_check">Skontrolovať, že prehliadač používa Tor</string>
    <string name="compartment_tor_check_sub">Otvorí check.torproject.org</string>
    <string name="compartment_i2p_keep_title">Ponechať I2P spustené na pozadí</string>
    <string name="compartment_i2p_keep_sub">Zostať pripojený k sieti I2P aj po opustení kompartmentu I2P, aby sa okamžite znova pripojil.</string>
    <string name="compartment_i2p_addressbook">Odbery adresára</string>
    <string name="compartment_i2p_addressbook_sub">Načítava zoznamy hosts.txt zvnútra I2P, aby sa .i2p stránky (reg.i2p, stats.i2p…) rozlišovali automaticky bez potreby jump služby. Použije sa pri ďalšom spustení I2P.</string>
    <string name="compartment_about_i2p">O sieti I2P</string>
    <string name="compartment_i2p_desc">I2P je peer-to-peer anonymná sieť. .i2p eepsite sa načítavajú priamo v I2P; bežné stránky sú smerované cez verejný I2P outproxy. Budovanie tunelov môže pri prvom použití chvíľu trvať.</string>
    <string name="compartment_normal_desc">Priame pripojenie bez vrstvy anonymity — najrýchlejšia možnosť, ale stránky vidia vašu skutočnú IP adresu. Keď chcete prehliadať súkromne, prepnite na Tor alebo I2P cez sieťové tlačidlo.</string>
